{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.example/fde/triage.output.json",
  "title": "triage agent output",
  "type": "object",
  "required": ["claimId", "amount", "outcome", "rationale", "citedSources"],
  "properties": {
    "claimId": { "type": "string" },
    "amount": { "type": "number" },
    "outcome": { "type": "string", "enum": ["approve", "deny", "refer"] },
    "rationale": { "type": "string", "maxLength": 4000 },
    "citedSources": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
